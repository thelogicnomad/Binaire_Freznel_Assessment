{
  "name": "binaire-freznel-assessment",
  "version": "1.0.0",
  "description": "Multi-user CSV queueing system with priority scheduling, worker threads, and live dashboard",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "build:client": "npm run build --prefix client",
    "start:server": "npm start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "csv",
    "worker-threads",
    "queue",
    "priority-queue",
    "socket.io",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
