# Server configuration
PORT=5001

# Allowed client origin (comma-separated if multiple, e.g. http://localhost:5173,https://my-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Worker pool settings
# Defaults to os.cpus().length if not set or set to 0
WORKER_POOL_SIZE=4

# Task execution timeout in milliseconds (prevents hung workers from permanently locking pool slots)
TASK_TIMEOUT_MS=30000
